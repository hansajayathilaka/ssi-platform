{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "",
  "title": "KYC Credential",
  "description": "KYC Credential for an individual trader or company, for identity and risk verification.",
  "type": "object",
  "version": "1.0.0",
  "properties": {
    "credentialSubject": {
      "type": "object",
      "properties": {
        "firstName": {
          "description": "Legal given name",
          "type": "string",
          "title": "First Name"
        },
        "lastName": {
          "description": "Legal surname",
          "type": "string",
          "title": "Last Name"
        },
        "dateOfBirth": {
          "description": "Date of birth (YYYY-MM-DD)",
          "type": "string",
          "format": "date",
          "title": "Date of Birth"
        },
        "nationality": {
          "description": "Country of citizenship",
          "type": "string",
          "title": "Nationality"
        },
        "email": {
          "description": "Contact email address",
          "type": "string",
          "format": "email",
          "title": "Email Address"
        },
        "phone": {
          "description": "Contact phone number",
          "type": "string",
          "title": "Phone Number"
        },
        "address": {
          "description": "Physical address",
          "type": "string",
          "title": "Address"
        },
        "kycLevel": {
          "description": "KYC verification level",
          "type": "string",
          "enum": ["basic", "standard", "advanced"],
          "title": "KYC Level"
        },
        "kycEntityType": {
          "description": "Entity type: company or trader",
          "type": "string",
          "enum": ["company", "trader"],
          "title": "Entity Type"
        },
        "pepStatus": {
          "description": "Politically exposed person status",
          "type": "boolean",
          "title": "PEP Status"
        },
        "amlCheckResult": {
          "description": "AML check result",
          "type": "string",
          "title": "AML Check Result"
        },
        "issuanceDate": {
          "description": "Credential issuance date/time",
          "type": "string",
          "format": "date-time",
          "title": "Issuance Date"
        }
      },
      "required": [
        "firstName",
        "lastName",
        "dateOfBirth",
        "nationality",
        "email",
        "phone",
        "kycEntityType"
      ],
      "additionalProperties": false
    }
  },
  "required": ["credentialSubject"],
  "additionalProperties": false
}