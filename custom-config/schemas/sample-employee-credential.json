{
  "id": "employee-credential-v1",
  "name": "Employee Credential",
  "version": "1.0.0",
  "description": "Standard employee credential schema",
  "fields": [
    {
      "name": "employeeId",
      "type": "string",
      "required": true,
      "displayName": "Employee ID",
      "description": "Unique employee identifier",
      "validation": [
        {
          "type": "pattern",
          "value": "^EMP[0-9]{6}$",
          "message": "Employee ID must be in format EMP123456"
        }
      ]
    },
    {
      "name": "fullName",
      "type": "string",
      "required": true,
      "displayName": "Full Name",
      "description": "Employee's full legal name"
    },
    {
      "name": "department",
      "type": "string",
      "required": true,
      "displayName": "Department",
      "description": "Employee's department"
    },
    {
      "name": "position",
      "type": "string",
      "required": true,
      "displayName": "Position",
      "description": "Employee's job position"
    },
    {
      "name": "startDate",
      "type": "date",
      "required": true,
      "displayName": "Start Date",
      "description": "Employee's start date"
    },
    {
      "name": "email",
      "type": "email",
      "required": true,
      "displayName": "Email Address",
      "description": "Employee's work email address"
    },
    {
      "name": "isActive",
      "type": "boolean",
      "required": true,
      "displayName": "Active Status",
      "description": "Whether the employee is currently active",
      "defaultValue": true
    }
  ],
  "metadata": {
    "category": "employment",
    "issuer": "HR Department",
    "validityPeriod": "1 year"
  },
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z"
}