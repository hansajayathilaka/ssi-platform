{
  "id": "student-credential-v1",
  "name": "Student Credential",
  "version": "1.0.0",
  "description": "Academic student credential schema",
  "fields": [
    {
      "name": "studentId",
      "type": "string",
      "required": true,
      "displayName": "Student ID",
      "description": "Unique student identifier",
      "validation": [
        {
          "type": "pattern",
          "value": "^STU[0-9]{7}$",
          "message": "Student ID must be in format STU1234567"
        }
      ]
    },
    {
      "name": "fullName",
      "type": "string",
      "required": true,
      "displayName": "Full Name",
      "description": "Student's full legal name"
    },
    {
      "name": "program",
      "type": "string",
      "required": true,
      "displayName": "Academic Program",
      "description": "Student's academic program"
    },
    {
      "name": "year",
      "type": "number",
      "required": true,
      "displayName": "Academic Year",
      "description": "Current academic year",
      "validation": [
        {
          "type": "min",
          "value": 1,
          "message": "Academic year must be at least 1"
        },
        {
          "type": "max",
          "value": 6,
          "message": "Academic year cannot exceed 6"
        }
      ]
    },
    {
      "name": "gpa",
      "type": "number",
      "required": false,
      "displayName": "GPA",
      "description": "Grade Point Average",
      "validation": [
        {
          "type": "min",
          "value": 0.0,
          "message": "GPA cannot be negative"
        },
        {
          "type": "max",
          "value": 4.0,
          "message": "GPA cannot exceed 4.0"
        }
      ]
    },
    {
      "name": "enrollmentDate",
      "type": "date",
      "required": true,
      "displayName": "Enrollment Date",
      "description": "Student's enrollment date"
    },
    {
      "name": "email",
      "type": "email",
      "required": true,
      "displayName": "Email Address",
      "description": "Student's academic email address"
    }
  ],
  "metadata": {
    "category": "education",
    "issuer": "Academic Registry",
    "validityPeriod": "4 years"
  },
  "createdAt": "2024-01-01T00:00:00Z",
  "updatedAt": "2024-01-01T00:00:00Z"
}